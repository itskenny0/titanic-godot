  "groups": [
    {
      "id": "a_deck",
      "title": "A-deck tour errors",
      "description": "Stops repeated script errors when entering A-deck corridors in Tour mode. Also includes sharper navigation images here.",
      "files": [
        "HALLA.SET"
      ]
    },
    {
      "id": "jay",
      "title": "Restore Jay",
      "description": "Restores Jay walking in the B-deck corridors, as in the CD release. Also includes sharper navigation images here.",
      "files": [
        "HALLB.SET"
      ]
    },
    {
      "id": "starboard",
      "title": "Starboard Boat Deck door",
      "description": "Corrects the Grand Staircase door that wrongly leads to A-deck promenade. Also includes sharper navigation images here.",
      "files": [
        "VESTSTBD.SET"
      ]
    },
    {
      "id": "port",
      "title": "Port Boat Deck door",
      "description": "Corrects the matching wrong destination on the port side. Also includes sharper navigation images here.",
      "files": [
        "VESTPORT.SET"
      ]
    },
    {
      "id": "trask",
      "title": "Trask on the stairs",
      "description": "Stops Trask clipping through the Grand Staircase. Also includes sharper navigation images here.",
      "files": [
        "GSTAIR2.SET"
      ]
    },
    {
      "id": "sharpness",
