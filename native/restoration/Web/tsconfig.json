{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@dreamfactory/taoot/cursor-art": ["./neutral-cursors.ts"],
      "@dreamfactory/engine/*": ["../../../vendor/dreamrefactory/engine/src/*"],
      "@dreamfactory/site/*": ["../../../vendor/dreamrefactory/site/src/*"],
      "@dreamfactory/taoot/*": ["../../../vendor/dreamrefactory/taoot/src/*"]
    }
  },
  "include": ["main.ts"]
}
