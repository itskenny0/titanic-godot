# PortMaster FRT disables native joypad input. Both sticks are mapped here.
start = f10
select = esc
a = enter
b = esc
x = space
y = f12
l1 = mouse_slow
r1 = enter
l2 = pageup
r2 = pagedown
r3 = mouse_left
up = up
up = repeat
down = down
down = repeat
left = left
left = repeat
right = right
right = repeat
left_analog_up = up
left_analog_up = repeat
left_analog_down = down
left_analog_down = repeat
left_analog_left = left
left_analog_left = repeat
left_analog_right = right
left_analog_right = repeat
right_analog_up = mouse_movement_up
right_analog_down = mouse_movement_down
right_analog_left = mouse_movement_left
right_analog_right = mouse_movement_right
deadzone_mode = scaled_radial
deadzone = 6000
deadzone_scale = 5
deadzone_delay = 16
mouse_slow_scale = 30
repeat_delay = 220
repeat_interval = 180
